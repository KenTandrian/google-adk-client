{
  "name": "google-adk-client",
  "version": "0.2.0",
  "description": "A TypeScript client library for Google ADK (Agent Development Kit).",
  "author": "Kenrick Tandrian <kenricktan11@gmail.com>",
  "packageManager": "pnpm@11.28.7",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "format": "biome format . --write",
    "lint": "biome check ./src",
    "lint:fix": "biome check --write ./src",
    "prepublishOnly": "pnpm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "exports": {
    ".": {
      "default": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./ai-sdk": {
      "default": "./dist/ai-sdk/index.js",
      "types": "./dist/ai-sdk/index.d.ts"
    },
    "./server": {
      "default": "./dist/server/index.js",
      "types": "./dist/server/index.d.ts"
    },
    "./react": {
      "default": "./dist/react/index.js",
      "types": "./dist/react/index.d.ts"
    }
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KenTandrian/google-adk-client.git"
  },
  "keywords": [
    "google-adk",
    "adk",
    "agent-development-kit",
    "ai",
    "agents",
    "gemini",
    "ai-sdk",
    "nextjs"
  ],
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/KenTandrian/google-adk-client/issues"
  },
  "homepage": "https://github.com/KenTandrian/google-adk-client#readme",
  "devDependencies": {
    "@assistant-ui/react": "0.15.32",
    "@assistant-ui/react-google-adk": "0.0.41",
    "@biomejs/biome": "2.6.5",
    "@google/adk": "2.4.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "ai": "7.0.163",
    "react": "19.3.1",
    "tsdown": "0.23.5",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "peerDependencies": {
    "@assistant-ui/react": ">=0.14.0",
    "@assistant-ui/react-google-adk": ">=0.0.10",
    "ai": "^7.0.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@assistant-ui/react": {
      "optional": true
    },
    "@assistant-ui/react-google-adk": {
      "optional": true
    },
    "ai": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  }
}

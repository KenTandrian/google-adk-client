{
  "name": "@kentandrian/google-adk",
  "version": "0.1.8",
  "description": "A TypeScript client library for the Google ADK (Agent Development Kit).",
  "packageManager": "pnpm@11.20.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "format": "biome format . --write",
    "lint": "biome check ./src",
    "lint:fix": "biome check --write ./src",
    "prepublishOnly": "pnpm run build",
    "test": "vitest"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./ai-sdk": {
      "import": "./dist/ai-sdk/index.js",
      "types": "./dist/ai-sdk/index.d.ts"
    },
    "./server": {
      "import": "./dist/server/index.js",
      "types": "./dist/server/index.d.ts"
    },
    "./react": {
      "import": "./dist/react/index.js",
      "types": "./dist/react/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KenTandrian/google-adk-client.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/KenTandrian/google-adk-client/issues"
  },
  "homepage": "https://github.com/KenTandrian/google-adk-client#readme",
  "devDependencies": {
    "@assistant-ui/react": "0.15.18",
    "@assistant-ui/react-google-adk": "0.0.28",
    "@biomejs/biome": "2.5.11",
    "@google/adk": "2.0.0",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "ai": "7.0.92",
    "react": "19.2.8",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "peerDependencies": {
    "@assistant-ui/react": ">=0.14.0",
    "@assistant-ui/react-google-adk": ">=0.0.10",
    "ai": "^7.0.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@assistant-ui/react": {
      "optional": true
    },
    "@assistant-ui/react-google-adk": {
      "optional": true
    },
    "ai": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  }
}
